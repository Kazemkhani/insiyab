# Insiyab voice relay configuration
# Copy this file to ~/.config/insiyab/voice.env and fill in the values.
# Never commit the real file. It stays outside the repository.

# ElevenLabs API key (from elevenlabs.io/app/settings)
ELEVENLABS_API_KEY=

# ElevenLabs phone number ID (run: node live/voice/relay.js --import-number)
ELEVENLABS_PHONE_NUMBER_ID=

# ElevenLabs voice ID for the relay agents (a calm British voice recommended)
ELEVENLABS_VOICE_ID=

# ElevenLabs TTS model (default: eleven_v4_turbo)
ELEVENLABS_VOICE_MODEL=

# Twilio account SID and auth token for --import-number only
TWILIO_LIVE_ACCOUNT_SID=
TWILIO_LIVE_AUTH_TOKEN=

# Shared key (24+ characters): protects POST /voice/incident
VOICE_SHARED_KEY=

# Public HTTPS address of this process (required for tool webhooks when setting up agents)
# Example: https://your-tunnel.trycloudflare.com
VOICE_PUBLIC_URL=

# Port (default: 7890)
VOICE_PORT=

# Set to armed to allow dialling (requires --live flag AND voice-numbers.txt)
INSIYAB_CALLS=
